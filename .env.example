# 로그인 기능 활성화. 개발 환경에서만 true로 설정합니다.
AUTH_ENABLED=
# 환경에 해당하는 Supabase 프로젝트 URL (https://<ref>.supabase.co).
SUPABASE_URL=
# Auth용 sb_publishable_ 형식 공개키. 서버 업무 데이터 키와 구분합니다.
SUPABASE_PUBLISHABLE_KEY=
# 신뢰하는 앱 주소. 로컬은 http://localhost:3000, Preview는 지정된 고정 주소.
APP_BASE_URL=

# 서버에서만 사용하는 sb_secret_ 키. 브라우저·NEXT_PUBLIC_ 변수에 넣지 않습니다.
SUPABASE_SECRET_KEY=
# 신청 만료/미완료 사진 정리 작업 호출용 비밀값. 외부 스케줄러 설정은 별도입니다.
CRON_SECRET=
